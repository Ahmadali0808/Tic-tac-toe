<Window x:Class="Tic_tac_toe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tic_tac_toe"
        mc:Ignorable="d"
        Title="Tic Tac Toe" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel Name="StartMenu" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Tic Tac Toe" FontSize="36" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
            <Button Content="Start Game" Width="200" Height="50" Click="StartGameButton_Click"/>
        </StackPanel>
        <Grid Name="GameGrid" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <local:XOcell Grid.Row="0" Grid.Column="0" Height="100" CellClicked="XOcell_Clicked"/>
            <local:XOcell Grid.Row="0" Grid.Column="1" Height="100" CellClicked="XOcell_Clicked"/>
            <local:XOcell Grid.Row="0" Grid.Column="2" Height="100" CellClicked="XOcell_Clicked"/>
            <local:XOcell Grid.Row="1" Grid.Column="0" Height="100" CellClicked="XOcell_Clicked"/>
            <local:XOcell Grid.Row="1" Grid.Column="1" Height="100" CellClicked="XOcell_Clicked"/>
            <local:XOcell Grid.Row="1" Grid.Column="2" Height="100" CellClicked="XOcell_Clicked"/>
            <local:XOcell Grid.Row="2" Grid.Column="0" Height="100" CellClicked="XOcell_Clicked"/>
            <local:XOcell Grid.Row="2" Grid.Column="1" Height="100" CellClicked="XOcell_Clicked"/>
            <local:XOcell Grid.Row="2" Grid.Column="2" Height="100" CellClicked="XOcell_Clicked"/>
        </Grid>

        <StackPanel Name="WinMenu" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Name="WinMessage" FontSize="36" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
            <Button Content="Play Again" Width="200" Height="50" Click="PlayAgainButton_Click"/>
        </StackPanel>
        <StackPanel Name="DrawMenu" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="It's a Draw!" FontSize="36" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
            <Button Content="Play Again" Width="200" Height="50" Click="PlayAgainButton_Click"/>

        </StackPanel>

    </Grid>
</Window>